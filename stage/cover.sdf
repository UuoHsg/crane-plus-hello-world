<?xml version="1.0" ?>
<!-- 目隠しの板（動く）。看板の正面側に立てて、看板を隠す -->
<sdf version="1.9">
  <model name="cover">
    <link name="link">
      <inertial>
        <mass>0.02</mass>
        <inertia><ixx>0.0000375</ixx><iyy>0.0000138</iyy><izz>0.0000243</izz></inertia>
      </inertial>
      <!-- 厚さ1.2cm × 幅12cm × 高さ9cm（看板より大きく、上の方をアームで押せる） -->
      <collision name="collision">
        <geometry><box><size>0.012 0.12 0.09</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.012 0.12 0.09</size></box></geometry>
        <material><ambient>1.0 0.55 0.1 1</ambient><diffuse>1.0 0.55 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
